# MongoDB – use either URI (Node/mongoose) or Data API (Cloudflare/fetch)

# Option 1: Connection URI (mongoose, works in Node – nuxt dev, VPS, etc.)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Option 2: Data API / App Services (fetch, works on Cloudflare)
# MONGODB_APP_ID=your-app-id
# MONGODB_API_KEY=your-data-api-key
# MONGODB_DATA_SOURCE=Cluster0
# MONGODB_DATABASE=mydb

# Force Data API even when MONGODB_URI is set (switch back to App Services)
# MONGODB_USE_DATA_API=true

API_URL=https://weather.hantha.digital

# Coolify manual deploy webhook (keep the real URL and token in .env only)
# COOLIFY_DEPLOY_WEBHOOK_URL=https://coolify.example.com/api/v1/deploy?uuid=your-deployment-uuid
# COOLIFY_DEPLOY_TOKEN=your-coolify-deploy-token

# Pichlberg station is IP-locked to 45.144.187.11.
# On any other host, point this at the PHP proxy uploaded there (pichlberg.php).
# PICHBERG_SOURCE_URL=https://<mittwald-domain>/pichlberg.php
# Fallback when that station is down. Called at most once a minute.
# PICHBERG_EMBED_URL=https://www.weatherlink.com/embeddablePage/summaryData/bace478de69c48d49e01c02ec4dd2e40
CRON_SECRET=your-cron-secret
WEATHERLINK_API_KEY=your-key
WEATHERLINK_API_SECRET=your-secret

# PWS (Weather.com) — https://developer.weather.com
WEATHER_COM_API_KEY=b14f361ba4134ac38f361ba4135ac371
# Optional (ms): success cache / error cache / min interval between 401 log lines
# PWS_OBSERVATIONS_CURRENT_CACHE_TTL_MS=60000
# PWS_OBSERVATIONS_ERROR_CACHE_TTL_MS=300000
# PWS_401_LOG_INTERVAL_MS=120000

# South Tyrol Buergernetz sensors (default 5 min)
# SOUTH_TIROL_SENSORS_CACHE_TTL_MS=300000
# SOUTH_TIROL_SENSORS_ERROR_CACHE_TTL_MS=300000

# Föhn / Open-Meteo (default 5 min success, 15 min after 429)
# FOEHN_SERIES_CACHE_TTL_MS=300000
# FOEHN_SERIES_ERROR_CACHE_TTL_MS=900000
# FOEHN_DIFF_CACHE_TTL_MS=300000
# FOEHN_DIFF_ERROR_CACHE_TTL_MS=900000
# OPEN_METEO_REQUEST_GAP_MS=400
